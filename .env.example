# Se leen variables del entorno del proceso; no se carga .env automáticamente.
RAG_PROVIDER=mock

# Adaptador exclusivo para servidor local sin facturación; activación explícita.
RAG_LOCAL_URL=http://127.0.0.1:11434/api/chat
RAG_LOCAL_MODEL=

# Adaptador para API OpenAI-compatible (activación explícita, requiere HTTPS).
# ADVERTENCIA DE SEGURIDAD: Nunca versione credenciales reales ni las exponga en logs/commits.
# RAG_API_KEY=tu_api_key_aqui
# RAG_API_URL=https://api.openai.com/v1/chat/completions
# RAG_API_MODEL=gpt-4o-mini
# RAG_API_TIMEOUT=60
